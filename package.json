{
  "name": "qrforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side QR code generator — everything runs in the browser.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  }
}
